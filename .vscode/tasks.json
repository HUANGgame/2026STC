{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Current C++ File",
            "type": "shell",
            "command": "& '${workspaceFolder}\\.vscode\\run-current-cpp.ps1' -SourcePath '${file}' -OutputName '${fileBasenameNoExtension}'",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Current C++ File",
            "type": "shell",
            "command": "& '${workspaceFolder}\\.vscode\\run-current-cpp.ps1' -SourcePath '${file}' -OutputName '${fileBasenameNoExtension}' -Run",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
