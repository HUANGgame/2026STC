{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Current C++ File",
            "type": "node-terminal",
            "request": "launch",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\run-current-cpp.ps1\" -SourcePath \"${file}\" -OutputName \"${fileBasenameNoExtension}\" -Run",
            "cwd": "${fileDirname}"
        }
    ]
}
